---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCmsArticles } from '../../lib/cms';
import { formatDate } from '../../lib/format';

const articles = (await getCollection('articles')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime() || a.data.title.localeCompare(b.data.title, 'zh-CN'),
);
const cmsArticles = await getCmsArticles(12);
---
<SiteLayout
  title="文章"
  description="潜界 AI 原创文章与研究精选：一人公司运营、AI Agent、需求验证、Product Hunt 机会观察、MRR 指标与独立开发者定价方法。"
>
  <section class="page-hero">
    <div class="container">
      <p class="section-eyebrow">ARTICLES · 潜界 AI 文章</p>
      <h1>为创业者写的<span>方法与研究。</span></h1>
      <p class="page-lead">
        这里收录潜界 AI 的原创长文，讨论一人公司如何借助 AI 运营、如何验证需求、如何定价与衡量增长；
        同时精选潜界 AI 博客近期发布的产品与商业情报研究。
      </p>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="list-block">
        <div class="list-heading">
          <h2>原创长文</h2>
          <p>系统讲清一个主题的方法论文章，适合从头阅读，也适合作为日常决策时的参考。</p>
        </div>
        <div class="article-list">
          {articles.map((a) => (
            <ArticleCard
              href={`/articles/${a.id}/`}
              title={a.data.title}
              summary={a.data.description}
              tag={a.data.category}
              meta={formatDate(a.data.pubDate)}
            />
          ))}
        </div>
      </div>

      {cmsArticles.length > 0 && (
        <div class="list-block">
          <div class="list-heading">
            <h2>博客近期研究</h2>
            <p>来自潜界 AI 博客的产品猎人、X 商业情报与 TrustMRR 栏目，摘要取自原文，点击前往博客阅读全文。</p>
          </div>
          <div class="article-list">
            {cmsArticles.map((a) => (
              <ArticleCard
                href={a.url}
                title={a.title}
                summary={a.summary}
                tag={a.category}
                meta={[formatDate(a.date), 'cms.qjai.org'].filter(Boolean).join(' · ')}
                external
              />
            ))}
          </div>
          <p class="list-note">更多内容请访问 <a class="text-link" href="https://cms.qjai.org/" target="_blank" rel="noopener noreferrer">潜界 AI 博客 ↗</a></p>
        </div>
      )}
    </div>
  </section>
</SiteLayout>
