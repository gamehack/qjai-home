---
import SiteLayout from '../layouts/SiteLayout.astro';
---
<SiteLayout title="页面不存在" description="你访问的页面不存在。">
  <section class="page-hero error-page">
    <div class="container page-hero-inner">
      <p class="section-eyebrow">404 · PAGE NOT FOUND</p>
      <h1>这里暂时<span>没有内容。</span></h1>
      <p>页面可能已移动，或地址输入有误。</p>
      <a class="button button-primary" href="/">返回首页</a>
    </div>
  </section>
</SiteLayout>
