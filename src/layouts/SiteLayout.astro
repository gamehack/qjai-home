---
import '../styles/global.css';

const {
  title = '潜界 AI',
  description = '潜界 AI，为创业者而生。一个 AI 原生、自主运行、持续进化的智能创新系统，持续创造服务创业者的内容与产品。',
  canonical,
  robots = 'index,follow,max-image-preview:large',
  ogType = 'website',
  jsonLd,
} = Astro.props;

const adsenseClient = 'ca-pub-5899854110234139';

const pageTitle = title === '潜界 AI' ? '潜界 AI｜为创业者而生' : `${title}｜潜界 AI`;
const canonicalUrl = canonical === false ? null : (canonical ?? new URL(Astro.url.pathname, 'https://qjai.org').toString());
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '潜界 AI',
  url: 'https://qjai.org/',
  logo: 'https://qjai.org/assets/qianjie-ai-mark.svg',
  description,
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-adsense-account" content={adsenseClient} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#081225" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{pageTitle}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/assets/qianjie-ai-mark.svg" type="image/svg+xml" fetchpriority="high" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="潜界 AI" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content="https://qjai.org/assets/og-cover.svg" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://qjai.org/assets/og-cover.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script
      is:inline
      async
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
      crossorigin="anonymous"
    ></script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container header-inner">
        <div class="brand-group">
          <a class="brand" href="/" aria-label="潜界 AI 首页">
            <img src="/assets/qianjie-ai-mark.svg" alt="" width="42" height="42" />
            <span class="brand-name">潜界 <strong>AI</strong></span>
          </a>
          <span class="header-slogan">为创业者而生</span>
        </div>

        <nav class="header-links" aria-label="潜界 AI 平台">
          <a class="header-link" href="/articles/">文章</a>
          <a class="header-link" href="/about/">关于</a>
          <a class="header-link" href="https://podcast.qjai.org/" target="_blank" rel="noopener noreferrer">播客</a>
          <a class="header-link" href="https://cms.qjai.org/" target="_blank" rel="noopener noreferrer">博客</a>
          <a class="header-link" href="https://tools.qjai.org/" target="_blank" rel="noopener noreferrer">工具</a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-main">
        <nav class="footer-nav" aria-label="站点信息">
          <a href="/articles/">文章</a>
          <a href="/about/">关于我们</a>
          <a href="/contact/">联系我们</a>
          <a href="/privacy/">隐私政策</a>
          <a href="https://cms.qjai.org/" target="_blank" rel="noopener noreferrer">博客</a>
          <a href="https://podcast.qjai.org/" target="_blank" rel="noopener noreferrer">播客</a>
          <a href="https://tools.qjai.org/" target="_blank" rel="noopener noreferrer">工具</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} 潜界 AI</span>
        <span>AI-NATIVE · AUTONOMOUS · CONTINUOUSLY EVOLVING</span>
      </div>
    </footer>
  </body>
</html>
