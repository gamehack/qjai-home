---
import '../styles/global.css';

const {
  title = '潜界 AI',
  description = '潜界 AI，专注探索 AI 在真实场景中的应用，打造简单、易用、真正解决问题的产品。',
  canonical,
  robots = 'index,follow,max-image-preview:large',
} = Astro.props;

const pageTitle = title === '潜界 AI' ? '潜界 AI｜为创业者而生' : `${title}｜潜界 AI`;
const canonicalUrl = canonical === false ? null : (canonical ?? new URL(Astro.url.pathname, 'https://qjai.org').toString());
const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: '潜界 AI',
  legalName: '上海元流未竭科技有限公司',
  url: 'https://qjai.org/',
  logo: 'https://qjai.org/assets/qianjie-ai-mark.svg',
  description,
};
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#081225" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <title>{pageTitle}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="image" href="/assets/qianjie-ai-mark.svg" type="image/svg+xml" fetchpriority="high" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="潜界 AI" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content="https://qjai.org/assets/og-cover.svg" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://qjai.org/assets/og-cover.svg" />
    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳转到正文</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>

    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="/" aria-label="潜界 AI 首页">
          <img src="/assets/qianjie-ai-mark.svg" alt="" width="42" height="42" />
          <span class="brand-name">潜界 <strong>AI</strong></span>
        </a>

        <nav class="desktop-nav" aria-label="主导航">
          <a class:list={['nav-link', { active: Astro.url.pathname === '/' }]} href="/">首页</a>
          <a class:list={['nav-link', { active: Astro.url.pathname.startsWith('/products') }]} href="/products/">产品</a>
          <a class:list={['nav-link', { active: Astro.url.pathname.startsWith('/about') }]} href="/about/">关于我们</a>
        </nav>

        <details class="mobile-nav">
          <summary aria-label="打开导航"><span></span><span></span></summary>
          <nav aria-label="移动端主导航">
            <a href="/">首页</a>
            <a href="/products/">产品</a>
            <a href="/about/">关于我们</a>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-main">
        <a class="footer-brand" href="/">
          <img src="/assets/qianjie-ai-mark.svg" alt="" width="34" height="34" />
          <span>潜界 <strong>AI</strong></span>
        </a>
        <p class="footer-slogan">为创业者而生。</p>
        <nav class="footer-nav" aria-label="页脚导航">
          <a href="/products/">产品</a>
          <a href="/about/">关于我们</a>
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>© {new Date().getFullYear()} 上海元流未竭科技有限公司</span>
        <span>QIANJIE AI · BUILT FOR REAL VALUE</span>
      </div>
    </footer>
  </body>
</html>
